{
	"name": "flux",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"version": "0.2.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#docs/*": "./docs/*",
		"#svelte-supersonic": "./src/lib/supersonic/index.ts"
	},
	"packageManager": "pnpm@11.16.0",
	"scripts": {
		"dev": "tsx scripts/engine.ts && tsx scripts/check_synthdefs.ts && NODE_OPTIONS=\"--import tsx\" vite dev",
		"build": "tsx scripts/engine.ts && NODE_OPTIONS=\"--import tsx\" vite build",
		"build:synthdefs": "tsx scripts/check_synthdefs.ts --force",
		"check:synthdefs": "tsx scripts/check_synthdefs.ts",
		"check:examples": "tsx scripts/parse.ts",
		"preview": "NODE_OPTIONS=\"--import tsx\" vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:coverage": "vitest run --project server --coverage",
		"test": "npm run test:unit -- --run",
		"test:container": "scripts/test-container.sh"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm lint-staged"
	},
	"lint-staged": {
		"*.{js,ts,svelte,svx,json,md,css,html}": "prettier --write"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"flux-engine": "https://github.com/aeskildsen/flux-engine/releases/download/v0.91.0-flux.2/flux-engine-0.91.0-flux.2.tgz",
		"globals": "^17.13.0",
		"lint-staged": "^17.6.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"simple-git-hooks": "^2.14.0",
		"supersonic-scsynth": "^0.91.0",
		"supersonic-scsynth-core": "^0.91.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.61.0",
		"chevrotain": "^13.2.0",
		"monaco-editor": "^0.57.0"
	}
}
